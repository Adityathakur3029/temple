{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ls *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx playwright test *)",
      "Bash(npx wrangler dev *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(npm run deploy*)",
      "Bash(npm run release*)",
      "Bash(npx wrangler deploy *)",
      "Bash(npx wrangler pages deploy *)",
      "Bash(npx wrangler r2 object put *)",
      "Bash(npx wrangler secret *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.dev.vars)"
    ]
  }
}
