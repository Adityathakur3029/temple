// Realtime Worker + Durable Objects (specs 01 and 05).
// The top level is the local `wrangler dev` setup. Deploys always name an environment
// (`npm run deploy:realtime -- --env staging|production`), via the `release` skill.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sannidhi-realtime",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "DIRECTORY", "class_name": "DirectoryDO" },
    ],
  },
  // Append-only. Never edit or remove a migration once it has been deployed.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "DirectoryDO"] }],

  // ALLOWED_ORIGINS: comma-separated app origins allowed to call /api/* and open /ws (spec 05 § Routes).
  // PER_IP_SOCKET_CAP: sockets per IP per instance, "0" for no cap (spec 05 § Abuse protection).
  // DEV_STATS: "1" serves /api/dev/stats for load tests (spec 12). Local only.
  // Vars are not inherited, so each environment lists all three.
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "PER_IP_SOCKET_CAP": "0",
    "DEV_STATS": "1",
  },

  "env": {
    // Origins are the web Worker (apps/web/wrangler.jsonc) on this account's workers.dev
    // subdomain until the domain is chosen (spec 00, open decision 1). If the subdomain is
    // renamed in the dashboard, update both entries and redeploy.
    "staging": {
      "vars": {
        "ALLOWED_ORIGINS": "https://sannidhi-web-staging.adityathakur-mca18-du-4c6.workers.dev",
        // No cap on staging, so a load test can run 50 bots from one machine.
        "PER_IP_SOCKET_CAP": "0",
        "DEV_STATS": "0",
      },
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "RoomDO" },
          { "name": "DIRECTORY", "class_name": "DirectoryDO" },
        ],
      },
    },
    // Production never allows the staging origin, so staging can't reach production (spec 01).
    "production": {
      "vars": {
        "ALLOWED_ORIGINS": "https://sannidhi-web-production.adityathakur-mca18-du-4c6.workers.dev",
        "PER_IP_SOCKET_CAP": "15",
        "DEV_STATS": "0",
      },
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "RoomDO" },
          { "name": "DIRECTORY", "class_name": "DirectoryDO" },
        ],
      },
    },
  },
}
