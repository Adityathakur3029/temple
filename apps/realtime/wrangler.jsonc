// Realtime Worker + Durable Objects (specs 01 and 05).
// The top level is the local `wrangler dev` setup. Deploys always name an environment
// (`npm run deploy:realtime -- --env staging|production`), via the `release` skill.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sannidhi-realtime",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "DIRECTORY", "class_name": "DirectoryDO" },
    ],
  },
  // Append-only. Never edit or remove a migration once it has been deployed.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "DirectoryDO"] }],

  // Comma-separated app origins allowed to call /api/* and open /ws (spec 05 § Routes).
  "vars": { "ALLOWED_ORIGINS": "http://localhost:5173" },

  "env": {
    // Origins use the Cloudflare Pages project "sannidhi" until the domain is chosen
    // (spec 00, open decision 1). Update them if Pages assigns a different subdomain.
    "staging": {
      "vars": { "ALLOWED_ORIGINS": "https://staging.sannidhi.pages.dev" },
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "RoomDO" },
          { "name": "DIRECTORY", "class_name": "DirectoryDO" },
        ],
      },
    },
    // Production never allows the staging origin, so staging can't reach production (spec 01).
    "production": {
      "vars": { "ALLOWED_ORIGINS": "https://sannidhi.pages.dev" },
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "RoomDO" },
          { "name": "DIRECTORY", "class_name": "DirectoryDO" },
        ],
      },
    },
  },
}
