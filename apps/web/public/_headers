# Workers static assets headers (spec 01 § System overview). Hashed build output never changes,
# so browsers keep it for a year. index.html keeps the default short caching.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Built models (spec 11). A release folder never changes once written.
/v/*
  Cache-Control: public, max-age=31536000, immutable
