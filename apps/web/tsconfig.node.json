{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    // vite.config.ts imports its plugin with the .ts extension, as Vite's native config loader needs.
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "vite-plugins",
    "test",
    "e2e",
    "src"
  ]
}
