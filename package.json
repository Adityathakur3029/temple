{
  "name": "sannidhi",
  "version": "0.0.0",
  "private": true,
  "description": "Sannidhi, an online Himalayan Shiva temple. See specs/README.md.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names realtime,web --prefix-colors magenta,cyan \"npm:dev:realtime\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w @sannidhi/web",
    "dev:realtime": "npm run dev -w @sannidhi/realtime",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @sannidhi/web",
    "check": "tsx tools/check/index.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:realtime": "tsx tools/deploy/realtime.ts",
    "deploy:web": "tsx tools/deploy/web.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
